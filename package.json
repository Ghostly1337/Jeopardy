{
  "name": "jeopardy",
  "private": true,
  "description": "Jeopardy-Board mit Host-Pult und Live-Spieleransicht",
  "scripts": {
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:e2e:relay": "E2E_TRANSPORT=relay node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:e2e:ws": "E2E_TRANSPORT=ws node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:load": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/load/relay-load.mjs"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "node-turn": "0.0.6",
    "peer": "1.0.2",
    "peerjs": "1.5.4",
    "playwright": "1.63.0",
    "qrcode-generator": "1.4.4"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "pg": "8.16.3",
    "ws": "8.18.3"
  }
}
